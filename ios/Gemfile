# Gemfile — Ruby toolchain pinning for iOS builds.
#
# Why this exists: Xcode 16's `PBXFileSystemSynchronizedRootGroup` uses
# pbxproj `objectVersion = 70`, which is only understood by xcodeproj
# 1.27.0+. EAS Build's default worker ships an older xcodeproj that
# rejects the file with "Unable to find compatibility version string for
# object version `70`". Pinning the gem versions here forces EAS (and any
# local `bundle exec pod install`) to use the matching toolchain.
#
# Sprint 19 — added so EAS Build can install pods for the SyncLink Widget
# Extension target without manual pre-install hooks.

source 'https://rubygems.org'

# RN 0.76 / Expo SDK 52 baseline ruby.
ruby '>= 3.1.0'

# CocoaPods 1.16+ understands Xcode 16 pbxproj v70.
gem 'cocoapods', '~> 1.16'
# xcodeproj 1.27+ adds objectVersion 70 support.
gem 'xcodeproj', '~> 1.27'
# activesupport 7.x ships cocoapods 1.16's hard requirement.
gem 'activesupport', '>= 6.1.7.5', '< 8.0.0'
