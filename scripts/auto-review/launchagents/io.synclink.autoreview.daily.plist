<?xml version="1.0" encoding="UTF-8"?>
<!--
  SyncLink Auto-Reviewer — daily review LaunchAgent.

  Runs `scripts/auto-review/run.sh daily-review` four times a day
  (03:00 / 09:00 / 15:00 / 21:00 KST) on the LEAD's Mac so big code
  changes get a fresh review within ~6h instead of waiting overnight.
  Logs to ~/Library/Logs/synclink-auto-review.log.

  Install / load:
     bash scripts/auto-review/install.sh
  Uninstall:
     launchctl unload ~/Library/LaunchAgents/io.synclink.autoreview.*.plist
     rm ~/Library/LaunchAgents/io.synclink.autoreview.*.plist

  Sprint 19 — see docs/architecture/AUTO_REVIEW.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.synclink.autoreview.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_ROOT__/scripts/auto-review/run.sh</string>
    <string>daily-review</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <!-- Every 6 hours — local Mac time. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/synclink-auto-review.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/synclink-auto-review.log</string>

  <!-- Inherit user PATH (npm, git, claude CLI) -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
