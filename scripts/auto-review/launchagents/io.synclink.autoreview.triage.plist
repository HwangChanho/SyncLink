<?xml version="1.0" encoding="UTF-8"?>
<!--
  SyncLink Auto-Reviewer — daily issue triage.
  Runs at 04:00 KST, right after the daily-review at 03:00, so the
  triager can ingest the freshest review.
  Sprint 19.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.synclink.autoreview.triage</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_ROOT__/scripts/auto-review/run.sh</string>
    <string>issue-triage</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/synclink-auto-review.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/synclink-auto-review.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
