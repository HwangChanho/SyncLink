<?xml version="1.0" encoding="UTF-8"?>
<!--
  SyncLink Auto-Reviewer — cost monitor.
  Twice a day (09:00 / 21:00 KST) — usage rolls slowly so this doesn't
  need 6h cadence; we still catch a runaway day before it doubles.
  Sprint 19.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.synclink.autoreview.cost</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_ROOT__/scripts/auto-review/run.sh</string>
    <string>cost-monitor</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/synclink-auto-review.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/synclink-auto-review.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
