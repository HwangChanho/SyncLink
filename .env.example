# =============================================================================
# SyncDay — Environment Variables Template
# =============================================================================
# 실제 값은 .env 또는 .env.development.local에 (git에 절대 커밋 금지).
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development             # development | staging | production
EAS_PROJECT_ID=

# ─── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                  # ⚠ 서버 사이드만. 클라이언트 노출 금지

# ─── Auth / Social ───────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_KAKAO_APP_KEY=
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# ─── RevenueCat ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_RC_API_KEY_IOS=
EXPO_PUBLIC_RC_API_KEY_ANDROID=
REVENUECAT_WEBHOOK_SECRET=

# ─── AdMob ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ADMOB_APP_ID_IOS=
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID=

# ─── 3rd-party SDKs ──────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_WEATHER_API_KEY=
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# ─── AI (Anthropic — assistant-chat 등) ─────────────────────────────────────
ANTHROPIC_API_KEY=                          # ⚠ Edge Function secret으로 옮기는 것을 권장

# ─── CI / Fastlane (절대 클라이언트 노출 금지) ─────────────────────────────
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=
NOTION_API_KEY=
NOTION_FEATURES_DB_ID=

# -----------------------------------------------------------------------------
# QA / E2E 계정 (@synclink.test 공용 비밀번호)
# 이 저장소는 PUBLIC 이므로 코드에 하드코딩하지 않는다. 값은 .env 에만 둔다.
#  · E2E_PASSWORD             — 노드 스크립트·maestro·bin/qa-full.sh 가 사용
#                               (scripts/lib/e2e-credentials.mjs 가 .env 도 읽어 준다)
#  · EXPO_PUBLIC_E2E_PASSWORD — dev 빌드 로그인 화면의 자동입력용.
#                               릴리스 빌드는 __DEV__ 가드로 블록째 제거되므로 번들에 안 남는다.
# -----------------------------------------------------------------------------
E2E_PASSWORD=
EXPO_PUBLIC_E2E_PASSWORD=

# =============================================================================
# 참고: synclink:mind product 환경변수는 ~/Desktop/Projects/syncmind/.env.example
# =============================================================================
