
# SyncLink Fastlane 설정
# 사용법:
#   fastlane beta          → 빌드 번호 자동 증가 + xcodebuild 빌드 + TestFlight 업로드
#   fastlane upload_only   → 기존 IPA 재업로드 (빌드 생략)

default_platform(:ios)

API_KEY_PATH = File.expand_path("../credentials/AuthKey_2GBSCKXQJ4.p8", __dir__)
API_KEY_ID   = "2GBSCKXQJ4"
API_ISSUER   = "5f89581a-d0c6-46c2-9461-78d5c08448fa"
PROJECT_ROOT = File.expand_path("..", __dir__)
IPA_PATH     = "#{PROJECT_ROOT}/build/SyncLink-ipa/SyncLink.ipa"

platform :ios do

  # ── beta: 빌드 번호 자동 증가 + xcodebuild + TestFlight 업로드 ───────────────
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER,
      key_filepath: API_KEY_PATH,
      in_house:     false,
    )

    unless options[:skip_build]
      # 0. match: cert/profile을 git repo에서 keychain에 동기화 (readonly)
      #    .env에 MATCH_PASSWORD + MATCH_GIT_BASIC_AUTHORIZATION 필요
      match(
        type:           "appstore",
        readonly:       true,
        app_identifier: ["io.synclink.app", "io.synclink.app.SyncLinkWidget"],
        api_key:        api_key,
      )

      # 1. 빌드 번호 자동 증가
      next_build = latest_testflight_build_number(api_key: api_key) + 1
      UI.message "빌드 번호: #{next_build}"

      # app.json 업데이트
      sh("node -e \"const fs=require('fs'); const j=JSON.parse(fs.readFileSync('#{PROJECT_ROOT}/app.json','utf8')); j.expo.ios.buildNumber='#{next_build}'; fs.writeFileSync('#{PROJECT_ROOT}/app.json',JSON.stringify(j,null,2)+'\\n');\"")

      # Info.plist 업데이트
      increment_build_number(
        build_number: next_build,
        xcodeproj:    "#{PROJECT_ROOT}/ios/SyncLink.xcodeproj",
      )

      # 2. xcodebuild archive (기존에 검증된 방식)
      sh("rm -rf '#{PROJECT_ROOT}/build/SyncLink.xcarchive' '#{PROJECT_ROOT}/build/SyncLink-ipa'")
      sh("xcodebuild " \
         "-workspace '#{PROJECT_ROOT}/ios/SyncLink.xcworkspace' " \
         "-scheme SyncLink " \
         "-configuration Release " \
         "-archivePath '#{PROJECT_ROOT}/build/SyncLink.xcarchive' " \
         "-allowProvisioningUpdates " \
         "-authenticationKeyPath '#{API_KEY_PATH}' " \
         "-authenticationKeyID #{API_KEY_ID} " \
         "-authenticationKeyIssuerID #{API_ISSUER} " \
         "SENTRY_DISABLE_AUTO_UPLOAD=true " \
         "archive")

      # 3. IPA export
      sh("xcodebuild -exportArchive " \
         "-archivePath '#{PROJECT_ROOT}/build/SyncLink.xcarchive' " \
         "-exportPath '#{PROJECT_ROOT}/build/SyncLink-ipa' " \
         "-exportOptionsPlist '#{PROJECT_ROOT}/ios/ExportOptions.plist' " \
         "-allowProvisioningUpdates " \
         "-authenticationKeyPath '#{API_KEY_PATH}' " \
         "-authenticationKeyID #{API_KEY_ID} " \
         "-authenticationKeyIssuerID #{API_ISSUER}")
    end

    # 4. TestFlight 업로드 (암호화 체크 자동 처리)
    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               IPA_PATH,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption:        false,
    )

    # 5. build-history.md 자동 업데이트 — 빌드/커밋/날짜를 한 행 append
    #    (어떤 빌드에 무슨 변경이 들어갔는지 추적 못 했던 카오스를 해소)
    history_path  = "#{PROJECT_ROOT}/docs/launch/build-history.md"
    if File.exist?(history_path)
      build_no   = next_build || sh("node -e \"console.log(require('#{PROJECT_ROOT}/app.json').expo.ios.buildNumber)\"").strip
      git_sha    = sh("git -C '#{PROJECT_ROOT}' rev-parse --short HEAD").strip
      today      = Time.now.strftime("%Y-%m-%d")
      subject    = sh("git -C '#{PROJECT_ROOT}' log -1 --pretty=%s").strip
      new_row    = "| #{build_no} | #{git_sha} | #{today} | #{subject} | uploaded |"
      File.open(history_path, "a") { |f| f.puts(new_row) }
      UI.message "📝 build-history.md 갱신: #{new_row}"
    else
      UI.important "build-history.md 없음 — 자동 추적 건너뜀"
    end

    UI.success "✅ TestFlight 업로드 완료!"
  end

  # ── fastlane match: 인증서/프로파일 git repo 동기화 ─────────────────────────
  #   - sync_signing: 매 빌드 직전 호출. 기존 repo에서 cert/profile 가져와 keychain에 설치.
  #   - migrate_signing: 한 번만 실행. 기존 portal cert/profile을 repo에 암호화 저장.
  #     호출 후 ExportOptions.plist의 provisioningProfiles UUID를 match 발급한 새 UUID로 교체 필요.
  lane :sync_signing do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID, issuer_id: API_ISSUER, key_filepath: API_KEY_PATH, in_house: false,
    )
    match(
      type:           "appstore",
      readonly:       true,
      app_identifier: ["io.synclink.app", "io.synclink.app.SyncLinkWidget"],
      api_key:        api_key,
    )
  end

  lane :migrate_signing do
    # 최초 1회: 기존 portal cert/profile은 force_for_new_devices=false 라도 새로 발급되며,
    # 기존 cert는 자동으로 revoke됨. Build 113까지의 IPA에는 영향 없음 (이미 서명 완료).
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID, issuer_id: API_ISSUER, key_filepath: API_KEY_PATH, in_house: false,
    )
    match(
      type:                  "appstore",
      app_identifier:        ["io.synclink.app", "io.synclink.app.SyncLinkWidget"],
      force_for_new_devices: false,
      api_key:               api_key,
    )
  end

  # ── 배포용 프로파일 다운로드 ────────────────────────────────────────────────
  lane :download_profiles do
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER,
      key_filepath: API_KEY_PATH,
      in_house:     false,
    )
    ["io.synclink.app", "io.synclink.app.SyncLinkWidget"].each do |id|
      get_provisioning_profile(
        api_key:        api_key,
        app_identifier: id,
        skip_install:   false,
        force:          true,
      )
    end
  end

  # ── Apple Distribution cert 재발급 + 프로파일 재발급 (revoke/머신 변경 복구) ─
  lane :reissue_signing do
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER,
      key_filepath: API_KEY_PATH,
      in_house:     false,
    )

    # 1. 새 Apple Distribution cert 발급 + keychain import
    get_certificates(
      api_key:              api_key,
      generate_apple_certs: true,
      output_path:          "#{PROJECT_ROOT}/credentials/cert-tmp",
    )

    # 2. 새 cert 기반 프로파일 force 재발급
    ["io.synclink.app", "io.synclink.app.SyncLinkWidget"].each do |id|
      get_provisioning_profile(
        api_key:        api_key,
        app_identifier: id,
        skip_install:   false,
        force:          true,
      )
    end
  end

  # ── ASC 인증서 상태 조회 (디버깅용 — 만료/revoke 의심 시) ────────────────
  lane :check_certs do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: API_KEY_ID, issuer_id: API_ISSUER, filepath: API_KEY_PATH,
    )
    certs = Spaceship::ConnectAPI::Certificate.all
    certs.each do |c|
      UI.message "Cert SHA1=#{c.serial_number} type=#{c.certificate_type} name=#{c.name} expiration=#{c.expiration_date} platform=#{c.platform}"
    end
  end

  # ── ASC 빌드 상태 조회 (업로드 후 PROCESSING/VALID/INVALID 확인) ──────────
  lane :check_builds do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: API_KEY_ID, issuer_id: API_ISSUER, filepath: API_KEY_PATH,
    )
    app = Spaceship::ConnectAPI::App.find("io.synclink.app")
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-uploadedDate", limit: 50,
      includes: "preReleaseVersion,buildBetaDetail",
    )
    builds.each do |b|
      pre = b.pre_release_version
      bbd = b.build_beta_detail
      UI.message "Build #{pre&.version} (build=#{b.version}) processing=#{b.processing_state} int=#{bbd&.internal_build_state} ext=#{bbd&.external_build_state} expired=#{b.expired} uploaded=#{b.uploaded_date}"
    end

    UI.message "─── 빌드 번호로 직접 조회 (33, 34, 35) ───"
    [33, 34, 35].each do |bn|
      hits = Spaceship::ConnectAPI::Build.all(
        app_id: app.id, build_number: bn.to_s,
        processing_states: "PROCESSING,FAILED,INVALID,VALID",
        includes: "preReleaseVersion,buildBetaDetail",
        limit: 5,
      )
      if hits.empty?
        UI.message "build=#{bn}: ASC API에 결과 없음"
      else
        hits.each do |b|
          pre = b.pre_release_version
          bbd = b.build_beta_detail
          UI.message "build=#{bn} HIT: version=#{pre&.version} processing=#{b.processing_state} int=#{bbd&.internal_build_state} ext=#{bbd&.external_build_state} expired=#{b.expired} uploaded=#{b.uploaded_date}"
        end
      end
    end
  end

  # ── 기존 IPA만 재업로드 ────────────────────────────────────────────────────
  lane :upload_only do
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER,
      key_filepath: API_KEY_PATH,
      in_house:     false,
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               IPA_PATH,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption:        false,
    )
  end

end
