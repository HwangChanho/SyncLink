.claude/

# Project documentation (not shipped)
docs/

# Backup files
*.bak

# E2E / QA screenshot artifacts
screenshots/

expo-env.d.ts

# Local credential store
credentials/

# Native iOS / Android dirs — regenerated by expo prebuild
# 🔑 2026-09-13 — 루트 한정. 🔴 EAS 는 .easignore 가 있으면 .gitignore 대신 이 파일을 따른다.
#    슬래시 없는 ios/·android/ 가 로컬 Expo 모듈(modules/*/ios·android)까지 빌드 사본에서 빼서
#    1.4.16 vc35 첫 빌드에 InstallSource 모듈이 조용히 빠졌다(dex 에 모듈 문자열 0건 실측).
/ios/
/android/
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Firebase config — GoogleService-Info.plist stays excluded (iOS uses a
# different path); google-services.json is intentionally NOT listed here so
# EAS uploads it for the Android build.
GoogleService-Info.plist

# 기타 민감 정보
*.cer
*.crt
*.pfx
service-account*.json
*-credentials.json
auth-token*
AuthKey_*
.npmrc
