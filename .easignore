build/
*.xcarchive

# Fastlane outputs
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
fastlane/README.md

# Metro
.metro-health-check*

# Env — 모든 .env 변형 ignore.
.env
.env.*
!.env.example
!.env.sample

