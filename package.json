{
  "name": "synclink",
  "version": "1.0.0",
  "description": "AI-powered shared calendar for couples, teams, and families",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll --maxWorkers=2",
    "test:ci": "jest --ci --passWithNoTests --forceExit --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 30",
    "postinstall": "patch-package",
    "test:e2e": "maestro test e2e/flows/",
    "test:e2e:launch": "maestro test e2e/flows/00_launch.yaml",
    "test:e2e:golden": "maestro test e2e/flows/05_golden_path.yaml",
    "test:e2e:studio": "maestro studio",
    "ai:eval": "node scripts/ai-eval/run.mjs",
    "ai:chat": "node scripts/ai-eval/playground.mjs",
    "test:e2e:ios-sim": "TEST_EMAIL=e2e-ios-sim-pro@synclink.test TEST_PASSWORD=e2etest1234 maestro test e2e/flows/",
    "test:e2e:critical": "TEST_EMAIL=e2e-ios-sim-pro@synclink.test TEST_PASSWORD=e2etest1234 maestro test e2e/flows/00_launch.yaml e2e/flows/01_login_dev.yaml e2e/flows/02_tab_navigation.yaml e2e/flows/03_event_create.yaml e2e/flows/04_planner_todo.yaml e2e/flows/05_golden_path.yaml e2e/flows/10_golden_path_login.yaml",
    "release:ios": "./scripts/release-ios.sh",
    "release:android": "./scripts/release-android.sh",
    "release:both": "./scripts/release-both.sh",
    "web:build": "EXPO_PUBLIC_APP_ENV=production expo export -p web && mv dist/assets/node_modules dist/assets/vendor && find dist/_expo/static/js/web -name '*.js' -exec sed -i '' 's|assets/node_modules|assets/vendor|g' {} +",
    "release:web": "npm run web:build && npx -y wrangler@latest pages deploy dist --project-name=synclink --branch=main --commit-dirty=true --commit-message=\"web release\"",
    "feature": "node scripts/notion-sync.mjs",
    "feature:start": "node scripts/notion-sync.mjs --status 진행 --feature",
    "feature:done": "node scripts/notion-sync.mjs --status 완료 --feature",
    "release:android-local": "./scripts/release-android-local.sh"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.10",
    "@react-native-async-storage/async-storage": "~2.1.0",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-voice/voice": "^3.1.5",
    "@sentry/react-native": "~6.14.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^53.0.27",
    "expo-apple-authentication": "~7.2.4",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-contacts": "~14.2.6",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "~18.1.11",
    "expo-image": "~2.4.1",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-localization": "~16.1.6",
    "expo-location": "~18.1.6",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-tracking-transparency": "~5.2.4",
    "expo-updates": "~0.28.18",
    "expo-web-browser": "~14.2.0",
    "i18next": "^26.0.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^17.0.4",
    "react-native": "0.79.6",
    "react-native-android-widget": "^0.16.0",
    "react-native-chart-kit": "^6.12.2",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "^14.7.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@bacons/apple-targets": "^4.0.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eas-cli": "^18.13.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "patch-package": "^8.0.1",
    "playwright": "^1.59.1",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 2,
    "workerIdleMemoryLimit": "512MB",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|@sentry/.*|native-base|react-native-svg|react-native-purchases)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "private": true
}
