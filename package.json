{
  "name": "synclink",
  "version": "1.0.0",
  "description": "AI-powered shared calendar for couples, teams, and families",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll --maxWorkers=2",
    "test:ci": "jest --ci --passWithNoTests --forceExit --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 30",
    "postinstall": "patch-package",
    "test:e2e": "maestro test e2e/flows/",
    "test:e2e:launch": "maestro test e2e/flows/00_launch.yaml",
    "test:e2e:golden": "maestro test e2e/flows/05_golden_path.yaml",
    "test:e2e:studio": "maestro studio",
    "release:ios": "./scripts/release-ios.sh",
    "release:android": "./scripts/release-android.sh",
    "release:both": "./scripts/release-both.sh",
    "release:web": "expo export -p web && npx -y wrangler@latest pages deploy dist --project-name=synclink --branch=main --commit-dirty=true --commit-message=\"web release\"",
    "feature": "node scripts/notion-sync.mjs",
    "feature:start": "node scripts/notion-sync.mjs --status 진행 --feature",
    "feature:done": "node scripts/notion-sync.mjs --status 완료 --feature",
    "release:android-local": "./scripts/release-android-local.sh"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.10",
    "@react-native-async-storage/async-storage": "~2.1.0",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "@react-native-voice/voice": "^3.1.5",
    "@sentry/react-native": "~6.10.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~52.0.36",
    "expo-apple-authentication": "~7.1.3",
    "expo-av": "~15.0.2",
    "expo-constants": "~17.0.0",
    "expo-contacts": "~14.0.5",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.6",
    "expo-image": "~2.0.7",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~14.0.1",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.4",
    "expo-network": "~7.0.5",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.0",
    "expo-tracking-transparency": "~5.1.1",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.0",
    "i18next": "^26.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.4",
    "react-native": "0.76.5",
    "react-native-android-widget": "^0.16.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.2.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@bacons/apple-targets": "^4.0.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.5",
    "patch-package": "^8.0.1",
    "playwright": "^1.59.1",
    "typescript": "~5.3.3",
    "wrangler": "^4.92.0"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 2,
    "workerIdleMemoryLimit": "512MB",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|@sentry/.*|native-base|react-native-svg|react-native-purchases)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "private": true
}
