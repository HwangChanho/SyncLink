{
  "expo": {
    "name": "SyncLink",
    "slug": "synclink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "synclink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A6CF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.synclink.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "프로필 사진 변경에 사용됩니다.",
        "NSCameraUsageDescription": "프로필 사진 촬영에 사용됩니다.",
        "NSUserNotificationsUsageDescription": "일정 리마인더 알림을 전송합니다.",
        "NSMicrophoneUsageDescription": "음성으로 일정을 입력하는 데 사용됩니다.",
        "NSSpeechRecognitionUsageDescription": "음성을 텍스트로 변환하여 일정을 입력합니다.",
        "NSLocationWhenInUseUsageDescription": "날씨 위젯에서 현재 위치의 날씨를 표시하는 데 사용됩니다.",
        "NSFaceIDUsageDescription": "앱 잠금 기능을 위해 Face ID를 사용합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A6CF7"
      },
      "package": "com.synclink.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.566250367732-cr1eindrr7rn5tpdivo21md5u5l3je14"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A6CF7",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 변경에 사용됩니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9ef6634-3221-4503-9ca0-3dee0e53ac45"
      }
    },
    "owner": "danielhwang"
  }
}
