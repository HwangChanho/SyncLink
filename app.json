{
  "expo": {
    "name": "SyncLink",
    "slug": "synclink",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./images/SyncDayLogo.png",
    "scheme": "synclink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./images/SyncDayLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.synclink.app",
      "appleTeamId": "QUVU2PY6PG",
      "newArchEnabled": false,
      "buildNumber": "112",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.synclink.app.widget"
        ]
      },
      "associatedDomains": [
        "applinks:synclink.pages.dev"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "프로필 사진 변경에 사용됩니다.",
        "NSCameraUsageDescription": "프로필 사진 촬영에 사용됩니다.",
        "NSUserNotificationsUsageDescription": "일정 리마인더 알림을 전송합니다.",
        "NSMicrophoneUsageDescription": "음성으로 일정을 입력하는 데 사용됩니다.",
        "NSSpeechRecognitionUsageDescription": "음성을 텍스트로 변환하여 일정을 입력합니다.",
        "NSLocationWhenInUseUsageDescription": "날씨 위젯에서 현재 위치의 날씨를 표시하는 데 사용됩니다.",
        "NSFaceIDUsageDescription": "앱 잠금 기능을 위해 Face ID를 사용합니다.",
        "NSContactsUsageDescription": "Space 멤버를 초대할 때 연락처에서 친구를 검색하기 위해 사용됩니다. 선택한 연락처만 초대 메시지를 보낼 때 일시적으로 참조합니다.",
        "NSUserTrackingUsageDescription": "이 앱은 개인화된 광고를 표시하기 위해 기기 간 활동을 연결할 수 있는 권한을 요청합니다. 거부해도 앱 기능에 제한은 없으며, 광고가 개인화되지 않은 형태로 표시됩니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./images/SyncDayLogo.png",
        "backgroundColor": "#000000"
      },
      "package": "io.synclink.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "synclink.pages.dev",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.566250367732-cr1eindrr7rn5tpdivo21md5u5l3je14"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A6CF7",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 변경에 사용됩니다."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Space 멤버를 초대할 때 연락처에서 친구를 검색하는 데 사용됩니다."
        }
      ],
      "@sentry/react-native",
      "@react-native-community/datetimepicker",
      "expo-location",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-2936938026486482~2712096301",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "이 앱은 개인화된 광고를 표시하기 위해 기기 간 활동을 연결할 수 있는 권한을 요청합니다. 거부해도 앱 기능에 제한은 없으며, 광고가 개인화되지 않은 형태로 표시됩니다."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "이 앱은 개인화된 광고를 표시하기 위해 기기 간 활동을 연결할 수 있는 권한을 요청합니다."
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SyncLinkWidget",
              "label": "SyncLink",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "640dp",
              "maxResizeHeight": "480dp",
              "resizeMode": "horizontal|vertical",
              "description": "오늘의 일정과 마감 임박 할 일을 한눈에.",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withAppGroupBridge",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9ef6634-3221-4503-9ca0-3dee0e53ac45"
      }
    },
    "owner": "danielhwang",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c9ef6634-3221-4503-9ca0-3dee0e53ac45",
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
