{
  "expo": {
    "name": "SyncLink",
    "slug": "synclink",
    "version": "1.4.9",
    "orientation": "portrait",
    "icon": "./images/TwotwoLogo.png",
    "scheme": "synclink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./images/TwotwoLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0D16"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.synclink.app",
      "appleTeamId": "QUVU2PY6PG",
      "appStoreUrl": "https://apps.apple.com/kr/app/id6763083903",
      "newArchEnabled": true,
      "buildNumber": "180",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.synclink.app.widget"
        ]
      },
      "associatedDomains": [
        "applinks:synclink.pages.dev"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "프로필 사진 변경에 사용됩니다.",
        "NSCameraUsageDescription": "프로필 사진 촬영에 사용됩니다.",
        "NSUserNotificationsUsageDescription": "일정 리마인더 알림을 전송합니다.",
        "NSMicrophoneUsageDescription": "음성으로 일정을 입력하는 데 사용됩니다.",
        "NSSpeechRecognitionUsageDescription": "음성을 텍스트로 변환하여 일정을 입력합니다.",
        "NSLocationWhenInUseUsageDescription": "날씨 위젯에서 현재 위치의 날씨를 표시하는 데 사용됩니다.",
        "NSFaceIDUsageDescription": "앱 잠금 기능을 위해 Face ID를 사용합니다.",
        "NSContactsUsageDescription": "Space 멤버를 초대할 때 연락처에서 친구를 검색하기 위해 사용됩니다. 선택한 연락처만 초대 메시지를 보낼 때 일시적으로 참조합니다.",
        "NSUserTrackingUsageDescription": "이 앱은 개인화된 광고를 표시하기 위해 기기 간 활동을 연결할 수 있는 권한을 요청합니다. 거부해도 앱 기능에 제한은 없으며, 광고가 개인화되지 않은 형태로 표시됩니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "투투리스트"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./images/TwotwoLogo_adaptive.png",
        "backgroundColor": "#000000"
      },
      "package": "io.synclink.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=io.synclink.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 28,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "synclink.pages.dev",
              "pathPrefix": "/space/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/AntDesign.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome5_Brands.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome5_Regular.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome5_Solid.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Entypo.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/EvilIcons.ttf"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.566250367732-cr1eindrr7rn5tpdivo21md5u5l3je14"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "5e43e8a397577f03e205798c03769079",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A6CF7",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 변경에 사용됩니다."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Space 멤버를 초대할 때 연락처에서 친구를 검색하는 데 사용됩니다."
        }
      ],
      "@sentry/react-native",
      "@react-native-community/datetimepicker",
      "expo-location",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-2936938026486482~2712096301",
          "androidAppId": "ca-app-pub-2936938026486482~3128360869",
          "userTrackingUsageDescription": "이 앱은 개인화된 광고를 표시하기 위해 기기 간 활동을 연결할 수 있는 권한을 요청합니다. 거부해도 앱 기능에 제한은 없으며, 광고가 개인화되지 않은 형태로 표시됩니다."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "이 앱은 개인화된 광고를 표시하기 위해 기기 간 활동을 연결할 수 있는 권한을 요청합니다."
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SyncLinkWidget",
              "label": "할 일",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "640dp",
              "maxResizeHeight": "480dp",
              "resizeMode": "horizontal|vertical",
              "description": "오늘 일정과 할 일. 체크박스를 눌러 바로 완료 처리.",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SyncLinkCalendarWidget",
              "label": "달력",
              "minWidth": "250dp",
              "minHeight": "220dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "640dp",
              "maxResizeHeight": "640dp",
              "resizeMode": "horizontal|vertical",
              "description": "이번 달 일정을 달력으로 한눈에.",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SyncLinkCheckWidget",
              "label": "체크",
              "minWidth": "140dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "640dp",
              "maxResizeHeight": "480dp",
              "resizeMode": "horizontal|vertical",
              "description": "할 일만 크게. 홈화면에서 바로 체크.",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withAppGroupBridge",
      "./plugins/withAndroidManifestMergerFix",
      "./plugins/withExcludeSupportLibs",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "useLegacyPackaging": false,
            "extraMavenRepos": [
              "https://jitpack.io",
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "react-native-edge-to-edge",
      "./plugins/with16KbAlignment",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성으로 일정을 입력하는 데 사용됩니다.",
          "speechRecognitionPermission": "음성을 텍스트로 변환하여 일정을 입력합니다.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withAndroidAppName"
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9ef6634-3221-4503-9ca0-3dee0e53ac45"
      },
      "androidAppName": "투투리스트"
    },
    "owner": "danielhwang",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c9ef6634-3221-4503-9ca0-3dee0e53ac45",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
